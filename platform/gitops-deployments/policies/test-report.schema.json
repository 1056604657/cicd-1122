{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.modernkemo/policies/test-report.schema.json",
  "title": "STG 测试报告",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.modernkemo/v1" },
    "kind": { "const": "TestReport" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "project", "app", "sourceTag", "digest"],
      "properties": {
        "releaseId": { "type": "string" },
        "project": { "type": "string" },
        "app": { "type": "string" },
        "sourceTag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executedBy", "executedAt", "pipelineUrl", "tests"],
      "properties": {
        "executedBy": { "type": "string" },
        "executedAt": { "type": "string" },
        "pipelineUrl": { "type": "string" },
        "summary": { "type": "string" },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "skipped"],
          "properties": {
            "total": { "type": "integer", "minimum": 1 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
