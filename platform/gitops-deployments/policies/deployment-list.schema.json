{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.modernkemo/policies/deployment-list.schema.json",
  "title": "生产部署清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.modernkemo/v1"
    },
    "kind": {
      "const": "DeploymentList"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "project",
        "requestedBy",
        "window"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^REL-[0-9]{8}-[0-9]{3}$"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "requestedBy": {
          "type": "string",
          "minLength": 3
        },
        "window": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applications",
        "rollbackPlan",
        "changeTicket"
      ],
      "properties": {
        "changeTicket": {
          "type": "string",
          "minLength": 1
        },
        "rollbackPlan": {
          "type": "string",
          "minLength": 1
        },
        "applications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sourceTag",
              "image",
              "previousImage",
              "stgTest",
              "testReport"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "sourceTag": {
                "type": "string",
                "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "image": {
                "type": "string",
                "pattern": "@sha256:[0-9a-f]{64}$"
              },
              "previousImage": {
                "type": "string",
                "pattern": "@sha256:[0-9a-f]{64}$"
              },
              "sourcePipeline": { "type": "string", "pattern": "^[1-9][0-9]*$" },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "downtime": {
                "type": "boolean"
              },
              "testReport": {
                "type": "string"
              },
              "stgTest": {
                "type": "object",
                "additionalProperties": false,
                "description": "供应商对「该镜像在 STG 测试通过」的确认。平台不代供应商判断测试结论，也不要求 STG 此刻正在运行该镜像——只要这个镜像曾经进过 STG（由流水线查 GitOps 历史确认），并由供应商在此确认测过，即可发布。",
                "required": [
                  "tested",
                  "confirmedBy"
                ],
                "properties": {
                  "tested": {
                    "const": true,
                    "description": "必须显式写 true。没测过就不要写这个字段，不要写 false 蒙过去。"
                  },
                  "confirmedBy": {
                    "type": "string",
                    "minLength": 3,
                    "description": "确认人（供应商侧负责人）"
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
                    "description": "确认日期"
                  },
                  "note": {
                    "type": "string",
                    "description": "测了什么、怎么测的（可空）"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
